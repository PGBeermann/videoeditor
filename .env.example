# Copie estas variables en la pestaña «Environment» de Dokploy

# Administrador inicial (se crea solo si aún no existe ninguno)
ADMIN_USER=admin
ADMIN_PASSWORD=cambie-esta-clave-larga

# Tamaño máximo por archivo subido (MB)
MAX_UPLOAD_MB=8192

# 1 = cookie de sesión solo por HTTPS (déjelo en 1 en producción)
COOKIE_SECURE=1

# Modelo de transcripción: tiny | base | small | medium | large-v3 | turbo
# En CPU: «small» es buen equilibrio para español; «medium» es más preciso y ~2-3 veces más lento.
WHISPER_MODEL=small
WHISPER_COMPUTE=int8
WHISPER_THREADS=0

# Calidad de exportación (x264): CRF menor = más calidad; preset más lento = archivo más pequeño
RENDER_CRF=20
RENDER_PRESET=veryfast
